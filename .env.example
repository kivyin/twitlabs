# Copy to .env and adjust as needed. Restart the Vite/server process after changes.

# Optional: put all runtime data (SQLite DB, attachments, account images, logs) outside the app.
# SQLITE_DATA_DIR=C:\Users\Kevin\AppData\Local\twitlabs\data

# Optional: override only the SQLite database file path.
# If unset, defaults to <SQLITE_DATA_DIR or ./data>/mydb.db
# SQLITE_DB_PATH=C:\Users\Kevin\AppData\Local\twitlabs\data\mydb.db

# Optional: override the baked app version used for GitHub release checks.
# Defaults to package.json "version". Keep this in sync with GitHub release tags.
# VITE_APP_VERSION=1.6
# APP_VERSION=1.6

# Optional: GitHub repo for release checks (owner/name).
# VITE_APP_REPO=kivyin/twitlabs
# GITHUB_REPO=kivyin/twitlabs

# How long to cache the GitHub latest-release check (seconds). Default: 300 (5 minutes).
# Use 0 to always re-fetch (still subject to GitHub rate limits).
# VERSION_CHECK_TTL_SECONDS=300

# Site-wide inactivity timeout in seconds (client UI + server session). Default: 300 (5 minutes).
# After this many seconds without activity, the user is signed out.
# SESSION_IDLE_SECONDS=300

# Receipt scan (Gemini)
# GEMINI_API_KEY=
